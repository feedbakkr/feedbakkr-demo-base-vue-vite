{
  "name": "feedbakkr-demo-base-vue-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:moderate": "pnpm audit --audit-level moderate",
    "security:osv": "osv-scanner --recursive .",
    "security:scan": "pnpm run security:audit && pnpm run security:osv",
    "security:scan:full": "pnpm run security:audit:moderate && pnpm run security:osv"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vue-tsc": "^3.2.7"
  }
}
